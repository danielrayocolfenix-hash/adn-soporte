# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_ENVIRONMENT=Development
# Hosts que "Probar endpoint" (consola de errores en QA) puede llamar.
# Agrega aquí los dominios de tus ambientes reales, ej: app.tudominio.com
