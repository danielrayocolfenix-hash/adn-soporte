# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (Postgres instalado nativamente)
POSTGRES_DB=adn_soporte
POSTGRES_USER=adn_soporte
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache / broker (Redis instalado nativamente)
REDIS_URL=redis://localhost:6379/0

# Mensajeria futura (RabbitMQ) - sin activar todavia
CELERY_BROKER_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
