# Clave de la API de Anthropic (https://console.anthropic.com/) para el
# diagnóstico automático con IA de la consola de errores. Opcional: si se
# deja vacía, ese botón simplemente queda desactivado.
ANTHROPIC_API_KEY=

# Base de datos (Postgres instalado nativamente)
POSTGRES_DB=adn_soporte
POSTGRES_USER=postgres
POSTGRES_PASSWORD=AracniTech2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache / broker (Redis instalado nativamente)
REDIS_URL=redis://localhost:6379/0

# Mensajeria futura (RabbitMQ) - sin activar todavia
CELERY_BROKER_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
